# ─────────────────────────────────────────────────────────────────────────────
#  LORD-V4D3R — Imperial Bridge configuration
#  Copy to .env and edit. Every value here is optional.
# ─────────────────────────────────────────────────────────────────────────────

# --- credentials (pick ONE; or omit all and use your existing claude login) ---
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_AUTH_TOKEN=<oauth access token>

# --- bridge ------------------------------------------------------------------
V4D3R_PORT=8787
V4D3R_HOST=127.0.0.1
V4D3R_MODEL=claude-opus-5
V4D3R_EFFORT=low
V4D3R_MAX_TURNS=12

# Read-only tool allowlist. Set to `none` for pure chat, or add tools you trust.
V4D3R_TOOLS=Read,Glob,Grep,WebSearch,WebFetch

# Browsers allowed to call the bridge. Add your GitHub Pages origin so the
# hosted console can reach a bridge running on your own machine.
V4D3R_ORIGINS=http://localhost:8787,http://127.0.0.1:8787,https://YOURNAME.github.io

# --- oauth (optional) --------------------------------------------------------
# Anthropic does not currently publish self-serve OAuth client registration for
# third-party apps. Fill these in if you have been issued a client, or if you
# are pointing the bridge at your own gateway that fronts the Anthropic API.
# The flow is Authorization Code + PKCE with a loopback redirect — no secret.
# V4D3R_OAUTH_AUTHORIZE_URL=
# V4D3R_OAUTH_TOKEN_URL=
# V4D3R_OAUTH_CLIENT_ID=
# V4D3R_OAUTH_SCOPES=user:inference
